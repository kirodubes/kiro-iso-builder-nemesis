#: configure_gui.py:78 functions.py:944
msgid "NVIDIA driver"
msgstr "NVIDIA sürücüsü"

#: configure_gui.py:80
msgid ""
"AMD / Intel / a VM (no NVIDIA card)? Pick 'none': no NVIDIA driver is baked "
"in, and at boot choose the first entry, 'open source: AMD / Intel', which "
"blacklists NVIDIA. The other options bake that NVIDIA driver set."
msgstr ""
"AMD, Intel veya sanal makine (NVIDIA kartı yok) mi kullanıyorsunuz? 'none' "
"seçin: hiçbir NVIDIA sürücüsü eklenmez. Açılışta NVIDIA'yı engelleyen ilk "
"seçeneği, 'open source: AMD / Intel' seçin. Diğer seçenekler, seçilen NVIDIA "
"sürücü grubunu ekler."

