#: configure_gui.py:340
msgid "Detecting…"
msgstr "Rilevamento…"

#: configure_gui.py:353
msgid "None found; sync repos first. Keeping the built-in list."
msgstr ""
"Nessun kernel trovato; sincronizza prima i repository. L’elenco integrato "
"verrà mantenuto."

#: configure_gui.py:357
#, python-brace-format
msgid "Found {count} kernel."
msgid_plural "Found {count} kernels."
msgstr[0] "Trovato {count} kernel."
msgstr[1] "Trovati {count} kernel."

#: configure_gui.py:367
msgid ""
"CachyOS repo is disabled (Kiro's default); enable it to add the CachyOS-only "
"kernels (eevdf, hardened, server, …)."
msgstr ""
"Il repository CachyOS è disabilitato (impostazione predefinita di Kiro); "
"abilitalo per aggiungere kernel esclusivi di CachyOS (eevdf, hardened, "
"server, …)."

#: configure_gui.py:372
msgid "Enabling CachyOS repo…"
msgstr "Abilitazione del repository CachyOS…"

#: configure_gui.py:382
msgid "CachyOS repo enabled; refreshing kernels…"
msgstr "Repository CachyOS abilitato; aggiornamento dei kernel…"

#: configure_gui.py:385
#, python-brace-format
