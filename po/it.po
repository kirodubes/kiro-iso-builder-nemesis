msgstr "Edizioni (ambienti desktop e window manager)"

#: configure_gui.py:137
msgid "Desktops"
msgstr "Ambienti desktop"

#: configure_gui.py:142
msgid "Window managers"
msgstr "Window manager"

#: configure_gui.py:149
msgid ""
"Tick what you want; each becomes a session you can pick at the SDDM login "
"screen. Tick at least one."
msgstr ""
"Seleziona ciò che vuoi; ogni edizione sarà una sessione selezionabile nella "
"schermata di accesso SDDM. Selezionane almeno una."

#: configure_gui.py:162
msgid "Default session (boots first)"
msgstr "Sessione predefinita (si avvia per prima)"

#: configure_gui.py:164
msgid "Which ticked edition the live ISO logs into first."
msgstr "Quale edizione selezionata userà l’ISO live per accedere per prima."

