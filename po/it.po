msgstr ""
"Seleziona almeno un ambiente desktop o un window manager; un’ISO richiede "
"una sessione."

#: configure_gui.py:464
msgid "Import build profile"
msgstr "Importa profilo di compilazione"

#: configure_gui.py:467
msgid "Kiro build profiles"
msgstr "Profili di compilazione Kiro"

#: configure_gui.py:487
#, python-brace-format
msgid ""
"Imported profile; {count} package to remove. Review the settings, then click "
"Save & Continue."
msgid_plural ""
"Imported profile; {count} packages to remove. Review the settings, then "
"click Save & Continue."
msgstr[0] ""
"Profilo importato; verrà rimosso {count} pacchetto. Controlla le "
"impostazioni e fai clic su Salva e continua."
msgstr[1] ""
"Profilo importato; verranno rimossi {count} pacchetti. Controlla le "
"impostazioni e fai clic su Salva e continua."

