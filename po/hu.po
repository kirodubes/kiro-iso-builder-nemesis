#: build_gui.py:37
msgid "Build the ISO"
msgstr "ISO-készítés"

#: build_gui.py:41
msgid ""
"Runs build-the-iso.sh as your user. You will be asked for your password "
"once; if the build prompts (for example, pacman's [Y/n]), type your reply in "
"the box below."
msgstr ""
"A build-the-iso.sh futtatása a saját felhasználóddal. A jelszavadat egyszer "
"kell megadnod. Ha a folyamat választ kér (például a pacman [Y/n] kérdésére), "
"írd be a válaszodat az alábbi mezőbe."

#: build_gui.py:60
msgid "Start build"
msgstr "Fordítás indítása"

#: build_gui.py:63
msgid "Stop"
msgstr "Leállítás"

#: build_gui.py:67 build_gui.py:162
msgid "Show summary"
msgstr "Összefoglaló megtekintése"

#: build_gui.py:68
msgid ""
"Open a page in your browser listing what this build removes, keeps and pulls "
"in, and why"
msgstr ""
"Megnyit egy oldalt a böngésződben arról, hogy ez a fordítás mit távolít el, "
"tart meg és ad hozzá, és miért"

#: build_gui.py:76
msgid "Idle"
msgstr "Tétlen"

#: build_gui.py:95
msgid "Reply to a build prompt (for example, y) and press Enter"
msgstr "Válaszolj a fordítás kérdésére (például y), majd nyomj Entert"

#: build_gui.py:97
msgid "Send"
msgstr "Küldés"

#: build_gui.py:104 configure_gui.py:195 extras_gui.py:88 packages_gui.py:102
msgid "← Back"
msgstr "← Vissza"

#: build_gui.py:113 configure_gui.py:460
#, python-brace-format
msgid "{repo} clone not found; fix it on the Pre-flight screen."
msgstr ""
"A(z) {repo} klón nem található; javítsd az Előzetes ellenőrzés oldalon."

#: build_gui.py:120
msgid "Work dir:"
msgstr "Munkamappa:"

#: build_gui.py:121
msgid "ISO output:"
msgstr "ISO kimenete:"

#: build_gui.py:123
msgid "Output location unknown; set the clone path on the Pre-flight screen."
msgstr ""
"A kimenet helye ismeretlen; állítsd be a klón útvonalát az Előzetes "
"ellenőrzés oldalon."

#: build_gui.py:138
msgid "Unticked but still on the ISO:\n"
msgstr "Nincs kijelölve, de az ISO-ban marad:\n"

#: build_gui.py:147
msgid "Preparing…"
msgstr "Előkészítés…"

#: build_gui.py:154
#, python-brace-format
msgid "Summary opened: {path}"
msgstr "Összefoglaló megnyitva: {path}"

#: build_gui.py:156
#, python-brace-format
msgid "Could not build the summary page: {error}"
msgstr "Nem sikerült létrehozni az összefoglaló oldalát: {error}"

#: build_gui.py:177
#, python-brace-format
msgid "Summary saved: {path}"
msgstr "Összefoglaló mentve: {path}"

#: build_gui.py:179
#, python-brace-format
msgid "Could not save the summary page: {error}"
msgstr "Nem sikerült menteni az összefoglaló oldalát: {error}"

#: build_gui.py:199
msgid "Starting…"
msgstr "Indítás…"

#: build_gui.py:200
msgid "── Starting build ──"
msgstr "── Fordítás indítása ──"

#: build_gui.py:245
#, python-brace-format
msgid "Phase {current} / {total}"
msgstr "{current} / {total}. lépés"

#: build_gui.py:256
msgid "Done"
msgstr "Kész"

#: build_gui.py:257
msgid "── Build finished ──"
msgstr "── A fordítás befejeződött ──"

#: build_gui.py:266
#, python-brace-format
msgid "Stopped (exit {code})"
msgstr "Leállítva (kilépési kód: {code})"

#: build_gui.py:267
#, python-brace-format
msgid "── Build stopped (exit {code}) ──"
msgstr "── A fordítás leállítva (kilépési kód: {code}) ──"

#: build_gui.py:269
#, python-brace-format
msgid "Failed (exit {code})"
msgstr "Sikertelen (kilépési kód: {code})"

#: build_gui.py:270
#, python-brace-format
msgid "── Build failed (exit {code}) ──"
msgstr "── A fordítás sikertelen (kilépési kód: {code}) ──"

#: build_gui.py:273
msgid "Cleaning up mounts…"
msgstr "Csatolások tisztítása…"

#: build_gui.py:274
msgid "── Stale build mounts found; cleaning up ──"
msgstr "── Régi fordítási csatolások találhatók; tisztítás ──"

#: build_gui.py:280
msgid "── Mount cleanup complete ──"
msgstr "── A csatolások tisztítása befejeződött ──"

#: build_gui.py:281
#, python-brace-format
msgid "── Mount cleanup exited with code {code} ──"
msgstr "── A csatolások tisztítása {code} kóddal ért véget ──"

#: build_gui.py:282
msgid "Cleaned up"
msgstr "Tisztítás kész"

#: build_gui.py:282
#, python-brace-format
msgid "Cleanup failed (exit {code})"
msgstr "Tisztítási hiba (kilépési kód: {code})"

#: build_gui.py:298 preflight_gui.py:330
msgid "Remove the leftover build folder?"
msgstr "Eltávolítod a megmaradt fordítási mappát?"

#: build_gui.py:299 preflight_gui.py:331
#, python-brace-format
msgid ""
"{path}{size}\n"
"\n"
"It is owned by root (mkarchiso ran as root), so you cannot delete it from "
"your file manager. Keeping it is fine; the next build reuses this location."
msgstr ""
"{path}{size}\n"
"\n"
"A mappa tulajdonosa a root (a mkarchiso rootként futott), ezért a "
"fájlkezelőből nem távolíthatod el. Megtarthatod; a következő fordítás újra "
"ezt a helyet használja."

#: build_gui.py:302 preflight_gui.py:335
msgid "Keep"
msgstr "Megtartás"

#: build_gui.py:302 preflight_gui.py:335
msgid "Remove"
msgstr "Eltávolítás"

#: build_gui.py:316
msgid "Removing build folder…"
msgstr "Fordítási mappa eltávolítása…"

#: build_gui.py:317
msgid "── Removing build folder (with your approval) ──"
msgstr "── Fordítási mappa eltávolítása a jóváhagyásoddal ──"

#: build_gui.py:321
msgid "── Build folder removed ──"
msgstr "── Fordítási mappa eltávolítva ──"

#: build_gui.py:322
#, python-brace-format
msgid "── Removing build folder failed (exit {code}) ──"
msgstr "── A fordítási mappa eltávolítása sikertelen (kilépési kód: {code}) ──"

#: build_gui.py:323
#, python-brace-format
msgid "Remove failed (exit {code})"
msgstr "Eltávolítás sikertelen (kilépési kód: {code})"

#: build_gui.py:323 functions.py:1084 functions.py:1105
msgid "Removed"
msgstr "Eltávolítva"

#: build_gui.py:335
#, python-brace-format
msgid "Could not open build log: {error}"
msgstr "Nem sikerült megnyitni a fordítási naplót: {error}"

#: configure_gui.py:24
msgid "All"
msgstr "Összes"

#: configure_gui.py:24
msgid "CachyOS"
msgstr "CachyOS"

#: configure_gui.py:24
msgid "Chaotic"
msgstr "Chaotic"

#: configure_gui.py:24
msgid "Official Arch"
msgstr "Hivatalos Arch"

#: configure_gui.py:66
msgid "Configure the build"
msgstr "Fordítás beállítása"

#: configure_gui.py:69
msgid "These write straight to build.conf; the CLI uses the same file."
msgstr ""
"Ezek a beállítások közvetlenül a build.conf fájlba kerülnek; a parancssori "
"felület is ezt a fájlt használja."

#: configure_gui.py:78 functions.py:944
msgid "NVIDIA driver"
msgstr "NVIDIA illesztőprogram"

#: configure_gui.py:80
msgid ""
"AMD / Intel / a VM (no NVIDIA card)? Pick 'none': no NVIDIA driver is baked "
"in, and at boot choose the first entry, 'open source: AMD / Intel', which "
"blacklists NVIDIA. The other options bake that NVIDIA driver set."
msgstr ""
"AMD, Intel vagy virtuális gép (NVIDIA GPU nélkül)? Válaszd a 'none' "
"lehetőséget: így nem kerül be NVIDIA-illesztőprogram. Indításkor válaszd az "
"első, 'open source: AMD / Intel' lehetőséget, amely letiltja az NVIDIA-t. A "
"többi lehetőség a hozzá tartozó NVIDIA-illesztőprogramokat építi be."

#: configure_gui.py:92
msgid "Kernel source"
msgstr "Kernel forrása"

#: configure_gui.py:100
msgid "First kernel (boots the live ISO)"
msgstr "Első kernel (elindítja az élő ISO-t)"

#: configure_gui.py:101
msgid "Second kernel (optional)"
msgstr "Második kernel (nem kötelező)"

#: configure_gui.py:104
msgid "Refresh kernels"
msgstr "Kernelek frissítése"

#: configure_gui.py:112
msgid ""
"The list includes every kernel offered by the repos that has matching "
"-headers (those headers are installed automatically for DKMS drivers). "
"Filter by source above, and type in a dropdown to search."
msgstr ""
"A lista az összes olyan, tárolóban elérhető kernelt tartalmazza, amelyhez "
"van megfelelő -headers csomag (ezeket a fejléceket a rendszer automatikusan "
"telepíti a DKMS-illesztőprogramokhoz). Szűrj a fenti forrás szerint, és a "
"kereséshez kezdj el gépelni a legördülő listában."

#: configure_gui.py:122
msgid "Enable CachyOS repo"
msgstr "CachyOS tároló engedélyezése"

#: configure_gui.py:132
msgid "Editions (desktops and window managers)"
msgstr "Kiadások (asztali környezetek és ablakkezelők)"

#: configure_gui.py:137
msgid "Desktops"
msgstr "Asztali környezetek"

#: configure_gui.py:142
msgid "Window managers"
msgstr "Ablakkezelők"

#: configure_gui.py:149
msgid ""
"Tick what you want; each becomes a session you can pick at the SDDM login "
"screen. Tick at least one."
msgstr ""
"Jelöld be, amit szeretnél; minden kiadás egy munkamenetként jelenik meg az "
"SDDM bejelentkezési képernyőjén. Legalább egyet jelölj be."

#: configure_gui.py:162
msgid "Default session (boots first)"
msgstr "Alapértelmezett munkamenet (ez indul először)"

#: configure_gui.py:164
msgid "Which ticked edition the live ISO logs into first."
msgstr "A bejelölt kiadás, amely először indul el az élő ISO-ban."

#: configure_gui.py:169
msgid "Advanced"
msgstr "Speciális"

#: configure_gui.py:172
msgid "Bump version before building"
msgstr "Verzió növelése fordítás előtt"

#: configure_gui.py:174
msgid "Clean pacman cache"
msgstr "pacman-gyorsítótár törlése"

#: configure_gui.py:176
msgid "Remove build folder after build"
msgstr "Fordítási mappa eltávolítása utána"

#: configure_gui.py:191
msgid "Reset to defaults"
msgstr "Alapértékek visszaállítása"

#: configure_gui.py:193
msgid "Import build profile…"
msgstr "Fordítási profil importálása…"

#: configure_gui.py:197 extras_gui.py:90 packages_gui.py:104
msgid "Save & Continue →"
msgstr "Mentés és folytatás →"

#: configure_gui.py:212
msgid "build.conf not found; fix the clone on the Pre-flight screen."
msgstr ""
"A build.conf nem található; javítsd a klónt az Előzetes ellenőrzés oldalon."

#: configure_gui.py:335
msgid "Reset to defaults; click Save & Continue to apply."
msgstr ""
"Alapértelmezések visszaállítva; alkalmazásukhoz kattints a Mentés és "
"folytatás gombra."

#: configure_gui.py:340
msgid "Detecting…"
msgstr "Észlelés…"

#: configure_gui.py:353
msgid "None found; sync repos first. Keeping the built-in list."
msgstr ""
"Nincs találat; először szinkronizáld a tárolókat. A beépített lista marad."

#: configure_gui.py:357
#, python-brace-format
msgid "Found {count} kernel."
msgid_plural "Found {count} kernels."
msgstr[0] "{count} kernel található."
msgstr[1] "{count} kernel található."

#: configure_gui.py:367
msgid ""
"CachyOS repo is disabled (Kiro's default); enable it to add the CachyOS-only "
"kernels (eevdf, hardened, server, …)."
msgstr ""
"A CachyOS tároló le van tiltva (ez a Kiro alapértelmezése); engedélyezd, "
"hogy CachyOS-specifikus kerneleket adj hozzá (eevdf, hardened, server, …)."

#: configure_gui.py:372
msgid "Enabling CachyOS repo…"
msgstr "CachyOS tároló engedélyezése…"

#: configure_gui.py:382
msgid "CachyOS repo enabled; refreshing kernels…"
msgstr "CachyOS tároló engedélyezve; kernelek frissítése…"

#: configure_gui.py:385
#, python-brace-format
msgid "Enabling CachyOS failed (exit {code})."
msgstr "Nem sikerült engedélyezni a CachyOS-t (kilépési kód: {code})."

#: configure_gui.py:441
msgid "Tick at least one desktop or window manager; an ISO needs a session."
msgstr ""
"Jelölj be legalább egy asztali környezetet vagy ablakkezelőt; az ISO-nak "
"szüksége van munkamenetre."

#: configure_gui.py:464
msgid "Import build profile"
msgstr "Fordítási profil importálása"

#: configure_gui.py:467
msgid "Kiro build profiles"
msgstr "Kiro fordítási profilok"

#: configure_gui.py:487
#, python-brace-format
msgid ""
"Imported profile; {count} package to remove. Review the settings, then click "
"Save & Continue."
msgid_plural ""
"Imported profile; {count} packages to remove. Review the settings, then "
"click Save & Continue."
msgstr[0] ""
"Profil importálva; {count} csomag eltávolításra kerül. Nézd át a "
"beállításokat, majd kattints a Mentés és folytatás gombra."
msgstr[1] ""
"Profil importálva; {count} csomag eltávolításra kerül. Nézd át a "
"beállításokat, majd kattints a Mentés és folytatás gombra."

#: done_gui.py:82
msgid "Build complete"
msgstr "Fordítás kész"

#: done_gui.py:98
msgid "Open output folder"
msgstr "Kimeneti mappa megnyitása"

#: done_gui.py:100
msgid "Test in VirtualBox"
msgstr "Tesztelés VirtualBoxban"

#: done_gui.py:102
msgid "Install VirtualBox"
msgstr "VirtualBox telepítése"

#: done_gui.py:104
msgid "Test in QEMU"
msgstr "Tesztelés QEMU-ban"

#: done_gui.py:106
msgid "Install QEMU"
msgstr "QEMU telepítése"

#: done_gui.py:108
msgid "Burn to USB"
msgstr "Kiírás USB-re"

#: done_gui.py:110
msgid "Install USB writer"
msgstr "USB-író telepítése"

#: done_gui.py:112
msgid "Open build log"
msgstr "Fordítási napló megnyitása"

#: done_gui.py:114
msgid "Save build profile…"
msgstr "Fordítási profil mentése…"

#: done_gui.py:116
msgid "Build again"
msgstr "Újrafordítás"

#: done_gui.py:131
msgid ""
"Note: the test VM only boots the ISO once to check the installer; it cannot "
"reboot into an installed system. Test a real install on hardware."
msgstr ""
"Megjegyzés: a teszt-VM egyszer indítja el az ISO-t a telepítő "
"ellenőrzéséhez; nem tud újraindulni a telepített rendszerbe. A valódi "
"telepítést hardveren próbáld ki."

#: done_gui.py:141
msgid "Output folder not found yet."
msgstr "A kimeneti mappa még nem található."

#: done_gui.py:146
#, python-brace-format
msgid "No ISO found in {path}"
msgstr "Nem található ISO itt: {path}"

#: done_gui.py:193
msgid "VirtualBox (VBoxManage) not installed."
msgstr "A VirtualBox (VBoxManage) nincs telepítve."

#: done_gui.py:196
msgid "Creating a VirtualBox VM (UEFI + 50 GB disk) and booting the ISO…"
msgstr ""
"VirtualBox-VM létrehozása (UEFI + 50 GB-os lemez), majd az ISO indítása…"

#: done_gui.py:223
msgid "VirtualBox VM started."
msgstr "VirtualBox-VM elindult."

#: done_gui.py:224
#, python-brace-format
msgid "VirtualBox launch failed (exit {code})."
msgstr "Nem sikerült elindítani a VirtualBoxot (kilépési kód: {code})."

#: done_gui.py:228
msgid "Installing VirtualBox + host DKMS + kernel headers (password required)…"
msgstr ""
"VirtualBox + host DKMS + kernel-fejlécek telepítése (jelszó szükséges)…"

#: done_gui.py:236
msgid ""
"VirtualBox installed. Reboot now (a log-out is not enough) to load the host "
"kernel modules and join the vboxusers group. Also enable virtualization in "
"your motherboard / BIOS-UEFI settings (Intel VT-x or AMD-V / SVM); "
"VirtualBox cannot run virtual machines without it."
msgstr ""
"A VirtualBox telepítve van. Indítsd újra most (a kijelentkezés nem elég), "
"hogy betöltődjenek a kernelmodulok és csatlakozz a vboxusers csoporthoz. A "
"virtualizációt az alaplap vagy a BIOS/UEFI beállításaiban is engedélyezd "
"(Intel VT-x vagy AMD-V / SVM); enélkül a VirtualBox nem tud VM-eket futtatni."

#: done_gui.py:244
#, python-brace-format
msgid "VirtualBox install failed (exit {code})."
msgstr "Nem sikerült telepíteni a VirtualBoxot (kilépési kód: {code})."

#: done_gui.py:255
msgid "OVMF not found (install edk2-ovmf); booting BIOS instead of UEFI."
msgstr ""
"Az OVMF nem található (telepítsd az edk2-ovmf csomagot); UEFI helyett BIOS "
"módban indul."

#: done_gui.py:268
msgid "qemu-img not found; the installer will have no disk to install on."
msgstr ""
"A qemu-img nem található; a telepítőnek nem lesz lemeze, ahová telepíthet."

#: done_gui.py:275
msgid "Creating a fresh 50 GB virtual disk for the installer…"
msgstr "Új, 50 GB-os virtuális lemez létrehozása a telepítő számára…"

#: done_gui.py:279
#, python-brace-format
msgid "Failed to create disk: {error}"
msgstr "Nem sikerült létrehozni a lemezt: {error}"

#: done_gui.py:285
msgid "Installing qemu-desktop (you will be asked for your password)…"
msgstr "A qemu-desktop telepítése (a rendszer kéri a jelszót)…"

#: done_gui.py:293
msgid "QEMU installed; you can now test in a VM."
msgstr "A QEMU telepítve van; most már tesztelhetsz VM-ben."

#: done_gui.py:298
#, python-brace-format
msgid "QEMU install failed (exit {code})."
msgstr "Nem sikerült telepíteni a QEMU-t (kilépési kód: {code})."

#: done_gui.py:310
msgid "Installing mintstick (you will be asked for your password)…"
msgstr "A mintstick telepítése (a rendszer kéri a jelszót)…"

#: done_gui.py:318
msgid "USB writer installed; you can now burn to USB."
msgstr "Az USB-író telepítve van; most már kiírhatod USB-re."

#: done_gui.py:323
#, python-brace-format
msgid "USB writer install failed (exit {code})."
msgstr "Nem sikerült telepíteni az USB-írót (kilépési kód: {code})."

#: done_gui.py:331
msgid "Save build profile"
msgstr "Fordítási profil mentése"

#: done_gui.py:348
#, python-brace-format
msgid "Saved build profile ({count} package removed) → {path}"
msgid_plural "Saved build profile ({count} packages removed) → {path}"
msgstr[0] "Profil mentve ({count} csomag eltávolítva) → {path}"
msgstr[1] "Profil mentve ({count} csomag eltávolítva) → {path}"

#: extras_gui.py:35
msgid "Add apps"
msgstr "Alkalmazások hozzáadása"

#: extras_gui.py:36
msgid "These apps are NOT on the standard Kiro; tick the ones you want added."
msgstr ""
"Ezek az alkalmazások NINCSENEK benne a normál Kiroban; jelöld be, amit hozzá "
"szeretnél adni."

#: extras_gui.py:37
msgid ""
"Nothing is ticked by default. Tick none and your ISO stays the standard Kiro."
msgstr ""
"Alapértelmezés szerint semmi sincs kijelölve. Ha nem jelölsz be semmit, az "
"ISO a normál Kiro marad."

#: extras_gui.py:40
#, python-brace-format
msgid "{edition} extras"
msgstr "{edition} extrák"

#: extras_gui.py:41
#, python-brace-format
msgid ""
"Optional {edition} apps, added only to this {edition} build; tick what you "
"want."
msgstr ""
"Opcionális {edition} alkalmazások, csak ehhez a {edition} fordításhoz "
"hozzáadva; jelöld be a kívántakat."

#: extras_gui.py:43
msgid "Nothing is ticked by default."
msgstr "Alapértelmezés szerint semmi sincs kijelölve."

#: extras_gui.py:44
msgid "Consider these a work in progress."
msgstr ""
"Vedd figyelembe, hogy ezek az alkalmazások még fejlesztés alatt állnak."

#: extras_gui.py:56
msgid "Search apps…"
msgstr "Alkalmazások keresése…"

#: extras_gui.py:58 packages_gui.py:73
msgid "Select all"
msgstr "Összes kijelölése"

#: extras_gui.py:60 packages_gui.py:75
msgid "Deselect all"
msgstr "Kijelölés megszüntetése"

#: extras_gui.py:77
msgid "Save app list…"
msgstr "Alkalmazáslista mentése…"

#: extras_gui.py:79
msgid "Import app list…"
msgstr "Alkalmazáslista importálása…"

#: extras_gui.py:122 packages_gui.py:125
msgid "packages.x86_64 not found; fix the clone on the Pre-flight screen."
msgstr ""
"A packages.x86_64 nem található; javítsd a klónt az Előzetes ellenőrzés "
"oldalon."

#: extras_gui.py:136
msgid "No extra apps are offered yet."
msgstr "Jelenleg nincs elérhető extra alkalmazás."

#: extras_gui.py:226
#, python-brace-format
msgid "App that will be added: {added}/{total}"
msgid_plural "Apps that will be added: {added}/{total}"
msgstr[0] "Hozzáadandó alkalmazás: {added}/{total}"
msgstr[1] "Hozzáadandó alkalmazások: {added}/{total}"

#: extras_gui.py:249
msgid "Save app list"
msgstr "Alkalmazáslista mentése"

#: extras_gui.py:263
#, python-brace-format
msgid "Saved app list ({count} app added) → {path}"
msgid_plural "Saved app list ({count} apps added) → {path}"
msgstr[0] "Alkalmazáslista mentve ({count} alkalmazás hozzáadva) → {path}"
msgstr[1] "Alkalmazáslista mentve ({count} alkalmazás hozzáadva) → {path}"

#: extras_gui.py:269
msgid "Import app list"
msgstr "Alkalmazáslista importálása"

#: extras_gui.py:282
#, python-brace-format
