msgstr[0] "Aplicación que se añadirá: {added}/{total}"
msgstr[1] "Aplicaciones que se añadirán: {added}/{total}"

#: extras_gui.py:249
msgid "Save app list"
msgstr "Guardar lista de aplicaciones"

#: extras_gui.py:263
#, python-brace-format
