msgid "Saved build profile ({count} package removed) → {path}"
msgid_plural "Saved build profile ({count} packages removed) → {path}"
msgstr[0] "Perfil guardado ({count} paquete eliminado) → {path}"
msgstr[1] "Perfil guardado ({count} paquetes eliminados) → {path}"

#: extras_gui.py:35
msgid "Add apps"
msgstr "Añadir aplicaciones"

#: extras_gui.py:36
