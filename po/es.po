msgstr "Abrir carpeta de salida"

#: done_gui.py:100
msgid "Test in VirtualBox"
msgstr "Probar en VirtualBox"

#: done_gui.py:102
msgid "Install VirtualBox"
msgstr "Instalar VirtualBox"

#: done_gui.py:104
msgid "Test in QEMU"
msgstr "Probar en QEMU"

#: done_gui.py:106
msgid "Install QEMU"
msgstr "Instalar QEMU"

#: done_gui.py:108
msgid "Burn to USB"
msgstr "Grabar en USB"

#: done_gui.py:110
msgid "Install USB writer"
msgstr "Instalar grabador USB"

#: done_gui.py:112
msgid "Open build log"
msgstr "Abrir registro de compilación"

#: done_gui.py:114
msgid "Save build profile…"
msgstr "Guardar perfil de compilación…"

#: done_gui.py:116
msgid "Build again"
msgstr "Compilar de nuevo"

#: done_gui.py:131
msgid ""
"Note: the test VM only boots the ISO once to check the installer; it cannot "
"reboot into an installed system. Test a real install on hardware."
msgstr ""
"Nota: la VM de prueba inicia la ISO una sola vez para comprobar el "
"instalador; no puede reiniciar en un sistema instalado. Prueba una "
"instalación real en hardware."

#: done_gui.py:141
msgid "Output folder not found yet."
msgstr "Aún no se encontró la carpeta de salida."

#: done_gui.py:146
#, python-brace-format
msgid "No ISO found in {path}"
msgstr "No se encontró ninguna ISO en {path}"

#: done_gui.py:193
msgid "VirtualBox (VBoxManage) not installed."
msgstr "VirtualBox (VBoxManage) no está instalado."

#: done_gui.py:196
msgid "Creating a VirtualBox VM (UEFI + 50 GB disk) and booting the ISO…"
msgstr ""
"Creando una VM de VirtualBox (UEFI + disco de 50 GB) e iniciando la ISO…"

#: done_gui.py:223
msgid "VirtualBox VM started."
msgstr "VM de VirtualBox iniciada."

#: done_gui.py:224
#, python-brace-format
msgid "VirtualBox launch failed (exit {code})."
msgstr "Error al iniciar VirtualBox (código de salida {code})."

#: done_gui.py:228
msgid "Installing VirtualBox + host DKMS + kernel headers (password required)…"
msgstr ""
"Instalando VirtualBox + DKMS del host + encabezados del kernel (se requiere "
"contraseña)…"

#: done_gui.py:236
msgid ""
"VirtualBox installed. Reboot now (a log-out is not enough) to load the host "
"kernel modules and join the vboxusers group. Also enable virtualization in "
"your motherboard / BIOS-UEFI settings (Intel VT-x or AMD-V / SVM); "
"VirtualBox cannot run virtual machines without it."
msgstr ""
"VirtualBox está instalado. Reinicia ahora (cerrar sesión no es suficiente) "
"para cargar los módulos del kernel y unirte al grupo vboxusers. También "
"activa la virtualización en los ajustes de la placa base o BIOS-UEFI (Intel "
"VT-x o AMD-V / SVM); VirtualBox no puede ejecutar máquinas virtuales sin "
"ella."

#: done_gui.py:244
#, python-brace-format
msgid "VirtualBox install failed (exit {code})."
msgstr "Error al instalar VirtualBox (código de salida {code})."

#: done_gui.py:255
msgid "OVMF not found (install edk2-ovmf); booting BIOS instead of UEFI."
msgstr ""
"No se encontró OVMF (instala edk2-ovmf); se iniciará con BIOS en lugar de "
"UEFI."

#: done_gui.py:268
msgid "qemu-img not found; the installer will have no disk to install on."
msgstr ""
"No se encontró qemu-img; el instalador no tendrá un disco donde instalarse."

#: done_gui.py:275
msgid "Creating a fresh 50 GB virtual disk for the installer…"
msgstr "Creando un disco virtual nuevo de 50 GB para el instalador…"

#: done_gui.py:279
#, python-brace-format
msgid "Failed to create disk: {error}"
msgstr "No se pudo crear el disco: {error}"

#: done_gui.py:285
msgid "Installing qemu-desktop (you will be asked for your password)…"
msgstr "Instalando qemu-desktop (se te pedirá la contraseña)…"

#: done_gui.py:293
msgid "QEMU installed; you can now test in a VM."
msgstr "QEMU está instalado; ya puedes probar en una VM."

#: done_gui.py:298
#, python-brace-format
msgid "QEMU install failed (exit {code})."
msgstr "Error al instalar QEMU (código de salida {code})."

#: done_gui.py:310
msgid "Installing mintstick (you will be asked for your password)…"
msgstr "Instalando mintstick (se te pedirá la contraseña)…"

#: done_gui.py:318
msgid "USB writer installed; you can now burn to USB."
msgstr "El grabador USB está instalado; ya puedes grabar en USB."

#: done_gui.py:323
#, python-brace-format
msgid "USB writer install failed (exit {code})."
msgstr "Error al instalar el grabador USB (código de salida {code})."

#: done_gui.py:331
msgid "Save build profile"
msgstr "Guardar perfil de compilación"

#: done_gui.py:348
