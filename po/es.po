msgstr[1] "Lista importada; se marcaron {count} aplicaciones para añadir."

#: functions.py:941
msgid "Editions"
msgstr "Ediciones"

#: functions.py:942
msgid "Default session"
msgstr "Sesión predeterminada"

#: functions.py:943
msgid "Kernel"
msgstr "Kernel"

#: functions.py:1084
msgid "Core"
msgstr "Base"

#: functions.py:1084
msgid "Frozen"
msgstr "Congelados"

#: functions.py:1085
msgid "Comes back"
msgstr "Vuelven"

#: functions.py:1085
msgid "Pulled in"
msgstr "Arrastrados"

#: functions.py:1087
msgid "Search packages or reasons..."
msgstr "Buscar paquetes o motivos…"

#: functions.py:1093
msgid "Kiro ISO build summary"
msgstr "Resumen de la compilación de la ISO de Kiro"

#: functions.py:1094
msgid "What this build puts on the ISO, and why."
msgstr "Lo que esta compilación pone en la ISO, y por qué."

#: functions.py:1097
msgid "This build"
msgstr "Esta compilación"

#: functions.py:1106
msgid ""
"You unticked these and nothing else needs them, so they are not on the ISO."
msgstr "Los desmarcaste y nada más los necesita, así que no están en la ISO."

#: functions.py:1107
msgid "Nothing removed."
msgstr "No se quitó nada."

#: functions.py:1109
msgid "Comes back anyway"
msgstr "Vuelven de todos modos"

#: functions.py:1110
msgid "You unticked these, but they still ship. The reason is on the right."
msgstr "Los desmarcaste, pero se incluyen igual. El motivo está a la derecha."

#: functions.py:1111
msgid "Every unticked package is really gone."
msgstr "Cada paquete desmarcado se ha ido de verdad."

#: functions.py:1115
msgid "Pulled in by your choices"
msgstr "Arrastrados por tus elecciones"

#: functions.py:1116
msgid ""
"Dependencies of your editions, add-ons and optional apps that the core alone "
"would not bring."
msgstr ""
"Dependencias de tus ediciones, complementos y apps opcionales que la base "
"sola no traería."

#: functions.py:1119
msgid "Frozen, TIER 1"
msgstr "Congelados, TIER 1"

#: functions.py:1120
msgid ""
"Always ship. Removing any of these breaks the build, the live boot or the "
"installer."
msgstr ""
"Siempre se incluyen. Quitar cualquiera rompe la compilación, el arranque "
"live o el instalador."

#: functions.py:1123
msgid "Core, TIER 2"
msgstr "Base, TIER 2"

#: functions.py:1124
msgid "Always ship. The base of every Kiro system."
msgstr "Siempre se incluyen. La base de todo sistema Kiro."

