#: build_gui.py:37
msgid "Build the ISO"
msgstr "Utwórz ISO"

#: build_gui.py:41
msgid ""
"Runs build-the-iso.sh as your user. You will be asked for your password "
"once; if the build prompts (for example, pacman's [Y/n]), type your reply in "
"the box below."
msgstr ""
"Uruchom build-the-iso.sh ze swojego konta użytkownika. Prośba o hasło pojawi "
"się raz. Jeśli kompilacja poprosi o odpowiedź (np. [Y/n] pacmana), wpisz ją "
"poniżej."

#: build_gui.py:60
msgid "Start build"
msgstr "Rozpocznij kompilację"

#: build_gui.py:63
msgid "Stop"
msgstr "Zatrzymaj"

#: build_gui.py:67 build_gui.py:162
msgid "Show summary"
msgstr "Pokaż podsumowanie"

#: build_gui.py:68
msgid ""
"Open a page in your browser listing what this build removes, keeps and pulls "
"in, and why"
msgstr ""
"Otwórz stronę w przeglądarce z informacją, co ta kompilacja usuwa, zachowuje "
"i dodaje oraz dlaczego"

#: build_gui.py:76
msgid "Idle"
msgstr "Bezczynny"

#: build_gui.py:95
msgid "Reply to a build prompt (for example, y) and press Enter"
msgstr "Odpowiedz na żądanie kompilacji (np. y) i naciśnij Enter"

#: build_gui.py:97
msgid "Send"
msgstr "Wyślij"

#: build_gui.py:104 configure_gui.py:195 extras_gui.py:88 packages_gui.py:102
msgid "← Back"
msgstr "← Wstecz"

#: build_gui.py:113 configure_gui.py:460
#, python-brace-format
msgid "{repo} clone not found; fix it on the Pre-flight screen."
msgstr "Nie znaleziono klonu {repo}; napraw to na ekranie kontroli wstępnej."

#: build_gui.py:120
msgid "Work dir:"
msgstr "Folder roboczy:"

#: build_gui.py:121
msgid "ISO output:"
msgstr "Wyjściowe ISO:"

#: build_gui.py:123
msgid "Output location unknown; set the clone path on the Pre-flight screen."
msgstr ""
"Nieznana lokalizacja wyjściowa; ustaw ścieżkę klonu na ekranie kontroli "
"wstępnej."

#: build_gui.py:138
msgid "Unticked but still on the ISO:\n"
msgstr "Niezaznaczone, ale pozostaną w ISO:\n"

#: build_gui.py:147
msgid "Preparing…"
msgstr "Przygotowywanie…"

#: build_gui.py:154
#, python-brace-format
msgid "Summary opened: {path}"
msgstr "Otwarto podsumowanie: {path}"

#: build_gui.py:156
#, python-brace-format
msgid "Could not build the summary page: {error}"
msgstr "Nie można utworzyć strony podsumowania: {error}"

#: build_gui.py:177
#, python-brace-format
msgid "Summary saved: {path}"
msgstr "Zapisano podsumowanie: {path}"

#: build_gui.py:179
#, python-brace-format
msgid "Could not save the summary page: {error}"
msgstr "Nie można zapisać strony podsumowania: {error}"

#: build_gui.py:199
msgid "Starting…"
msgstr "Uruchamianie…"

#: build_gui.py:200
msgid "── Starting build ──"
msgstr "── Rozpoczynanie kompilacji ──"

#: build_gui.py:245
#, python-brace-format
msgid "Phase {current} / {total}"
msgstr "Etap {current} / {total}"

#: build_gui.py:256
msgid "Done"
msgstr "Gotowe"

#: build_gui.py:257
msgid "── Build finished ──"
msgstr "── Kompilacja zakończona ──"

#: build_gui.py:266
#, python-brace-format
msgid "Stopped (exit {code})"
msgstr "Zatrzymano (kod wyjścia {code})"

#: build_gui.py:267
#, python-brace-format
msgid "── Build stopped (exit {code}) ──"
msgstr "── Zatrzymano kompilację (kod wyjścia {code}) ──"

#: build_gui.py:269
#, python-brace-format
msgid "Failed (exit {code})"
msgstr "Niepowodzenie (kod wyjścia {code})"

#: build_gui.py:270
#, python-brace-format
msgid "── Build failed (exit {code}) ──"
msgstr "── Kompilacja nie powiodła się (kod wyjścia {code}) ──"

#: build_gui.py:273
msgid "Cleaning up mounts…"
msgstr "Czyszczenie montowań…"

#: build_gui.py:274
msgid "── Stale build mounts found; cleaning up ──"
msgstr "── Znaleziono stare montowania kompilacji; czyszczenie ──"

#: build_gui.py:280
msgid "── Mount cleanup complete ──"
msgstr "── Czyszczenie montowań zakończone ──"

#: build_gui.py:281
#, python-brace-format
msgid "── Mount cleanup exited with code {code} ──"
msgstr "── Czyszczenie montowań zakończono z kodem {code} ──"

#: build_gui.py:282
msgid "Cleaned up"
msgstr "Czyszczenie zakończone"

#: build_gui.py:282
#, python-brace-format
msgid "Cleanup failed (exit {code})"
msgstr "Błąd czyszczenia (kod wyjścia {code})"

#: build_gui.py:298 preflight_gui.py:330
msgid "Remove the leftover build folder?"
msgstr "Usunąć pozostały folder kompilacji?"

#: build_gui.py:299 preflight_gui.py:331
#, python-brace-format
msgid ""
"{path}{size}\n"
"\n"
"It is owned by root (mkarchiso ran as root), so you cannot delete it from "
"your file manager. Keeping it is fine; the next build reuses this location."
msgstr ""
"{path}{size}\n"
"\n"
"Folder należy do użytkownika root (mkarchiso uruchomiono jako root), więc "
"nie możesz usunąć go w menedżerze plików. Możesz go zachować; następna "
"kompilacja ponownie użyje tej lokalizacji."

#: build_gui.py:302 preflight_gui.py:335
msgid "Keep"
msgstr "Zachowaj"

#: build_gui.py:302 preflight_gui.py:335
msgid "Remove"
msgstr "Usuń"

#: build_gui.py:316
msgid "Removing build folder…"
msgstr "Usuwanie folderu kompilacji…"

#: build_gui.py:317
msgid "── Removing build folder (with your approval) ──"
msgstr "── Usuwanie folderu kompilacji za Twoją zgodą ──"

#: build_gui.py:321
msgid "── Build folder removed ──"
msgstr "── Usunięto folder kompilacji ──"

#: build_gui.py:322
#, python-brace-format
msgid "── Removing build folder failed (exit {code}) ──"
msgstr "── Nie udało się usunąć folderu kompilacji (kod wyjścia {code}) ──"

#: build_gui.py:323
#, python-brace-format
msgid "Remove failed (exit {code})"
msgstr "Nie udało się usunąć (kod wyjścia {code})"

#: build_gui.py:323 functions.py:1084 functions.py:1105
msgid "Removed"
msgstr "Usunięto"

#: build_gui.py:335
#, python-brace-format
msgid "Could not open build log: {error}"
msgstr "Nie można otworzyć dziennika kompilacji: {error}"

#: configure_gui.py:24
msgid "All"
msgstr "Wszystkie"

#: configure_gui.py:24
msgid "CachyOS"
msgstr "CachyOS"

#: configure_gui.py:24
msgid "Chaotic"
msgstr "Chaotic"

#: configure_gui.py:24
msgid "Official Arch"
msgstr "Oficjalny Arch"

#: configure_gui.py:66
msgid "Configure the build"
msgstr "Konfiguracja kompilacji"

#: configure_gui.py:69
msgid "These write straight to build.conf; the CLI uses the same file."
msgstr ""
"Te ustawienia są zapisywane bezpośrednio w pliku build.conf; CLI korzysta z "
"tego samego pliku."

#: configure_gui.py:78 functions.py:944
msgid "NVIDIA driver"
msgstr "Sterownik NVIDIA"

#: configure_gui.py:80
msgid ""
"AMD / Intel / a VM (no NVIDIA card)? Pick 'none': no NVIDIA driver is baked "
"in, and at boot choose the first entry, 'open source: AMD / Intel', which "
"blacklists NVIDIA. The other options bake that NVIDIA driver set."
msgstr ""
"Masz kartę AMD lub Intel albo używasz maszyny wirtualnej bez GPU NVIDIA? "
"Wybierz 'none': żaden sterownik NVIDIA nie zostanie dołączony. Podczas "
"uruchamiania wybierz pierwszą opcję, 'open source: AMD / Intel', która "
"blokuje NVIDIA. Pozostałe opcje dołączają odpowiedni zestaw sterowników "
"NVIDIA."

#: configure_gui.py:92
msgid "Kernel source"
msgstr "Źródło kernela"

#: configure_gui.py:100
msgid "First kernel (boots the live ISO)"
msgstr "Pierwszy kernel (uruchamia ISO live)"

#: configure_gui.py:101
msgid "Second kernel (optional)"
msgstr "Drugi kernel (opcjonalny)"

#: configure_gui.py:104
msgid "Refresh kernels"
msgstr "Odśwież kernele"

#: configure_gui.py:112
msgid ""
"The list includes every kernel offered by the repos that has matching "
"-headers (those headers are installed automatically for DKMS drivers). "
"Filter by source above, and type in a dropdown to search."
msgstr ""
"Lista obejmuje wszystkie kernele dostępne w repozytoriach, które mają "
"odpowiednie pakiety -headers (nagłówki są instalowane automatycznie dla "
"sterowników DKMS). Filtruj według źródła powyżej i wpisz tekst na liście "
"rozwijanej, aby wyszukać."

#: configure_gui.py:122
msgid "Enable CachyOS repo"
msgstr "Włącz repozytorium CachyOS"

#: configure_gui.py:132
msgid "Editions (desktops and window managers)"
msgstr "Wydania (środowiska graficzne i menedżery okien)"

#: configure_gui.py:137
msgid "Desktops"
msgstr "Środowiska graficzne"

#: configure_gui.py:142
msgid "Window managers"
msgstr "Menedżery okien"

#: configure_gui.py:149
msgid ""
"Tick what you want; each becomes a session you can pick at the SDDM login "
"screen. Tick at least one."
msgstr ""
"Zaznacz wybrane pozycje; każde wydanie będzie sesją do wyboru na ekranie "
"logowania SDDM. Zaznacz co najmniej jedno."

#: configure_gui.py:162
msgid "Default session (boots first)"
msgstr "Domyślna sesja (uruchamiana jako pierwsza)"

#: configure_gui.py:164
msgid "Which ticked edition the live ISO logs into first."
msgstr "Zaznaczone wydanie, które uruchamia się jako pierwsze w ISO live."

#: configure_gui.py:169
msgid "Advanced"
msgstr "Zaawansowane"

#: configure_gui.py:172
msgid "Bump version before building"
msgstr "Zwiększ wersję przed kompilacją"

#: configure_gui.py:174
msgid "Clean pacman cache"
msgstr "Wyczyść pamięć podręczną pacmana"

#: configure_gui.py:176
msgid "Remove build folder after build"
msgstr "Usuń folder kompilacji po zakończeniu"

#: configure_gui.py:191
msgid "Reset to defaults"
msgstr "Przywróć ustawienia domyślne"

#: configure_gui.py:193
msgid "Import build profile…"
msgstr "Importuj profil kompilacji…"

#: configure_gui.py:197 extras_gui.py:90 packages_gui.py:104
msgid "Save & Continue →"
msgstr "Zapisz i kontynuuj →"

#: configure_gui.py:212
msgid "build.conf not found; fix the clone on the Pre-flight screen."
msgstr "Nie znaleziono build.conf; napraw klon na ekranie kontroli wstępnej."

#: configure_gui.py:335
msgid "Reset to defaults; click Save & Continue to apply."
msgstr ""
"Przywrócono wartości domyślne; kliknij Zapisz i kontynuuj, aby je zastosować."

#: configure_gui.py:340
msgid "Detecting…"
msgstr "Wykrywanie…"

#: configure_gui.py:353
msgid "None found; sync repos first. Keeping the built-in list."
msgstr ""
"Nic nie znaleziono; najpierw zsynchronizuj repozytoria. Zachowano wbudowaną "
"listę."

#: configure_gui.py:357
#, python-brace-format
msgid "Found {count} kernel."
msgid_plural "Found {count} kernels."
msgstr[0] "Znaleziono {count} kernel."
msgstr[1] "Znaleziono {count} kernele."
msgstr[2] "Znaleziono {count} kerneli."

#: configure_gui.py:367
msgid ""
"CachyOS repo is disabled (Kiro's default); enable it to add the CachyOS-only "
"kernels (eevdf, hardened, server, …)."
msgstr ""
"Repozytorium CachyOS jest wyłączone (domyślne ustawienie Kiro); włącz je, "
"aby dodać kernele dostępne tylko w CachyOS (eevdf, hardened, server, …)."

#: configure_gui.py:372
msgid "Enabling CachyOS repo…"
msgstr "Włączanie repozytorium CachyOS…"

#: configure_gui.py:382
msgid "CachyOS repo enabled; refreshing kernels…"
msgstr "Repozytorium CachyOS włączone; odświeżanie kerneli…"

#: configure_gui.py:385
#, python-brace-format
msgid "Enabling CachyOS failed (exit {code})."
msgstr "Nie udało się włączyć CachyOS (kod wyjścia {code})."

#: configure_gui.py:441
msgid "Tick at least one desktop or window manager; an ISO needs a session."
msgstr ""
"Zaznacz co najmniej jedno środowisko graficzne lub menedżer okien; ISO "
"wymaga sesji."

#: configure_gui.py:464
msgid "Import build profile"
msgstr "Importuj profil kompilacji"

#: configure_gui.py:467
msgid "Kiro build profiles"
msgstr "Profile kompilacji Kiro"

#: configure_gui.py:487
#, python-brace-format
msgid ""
"Imported profile; {count} package to remove. Review the settings, then click "
"Save & Continue."
msgid_plural ""
"Imported profile; {count} packages to remove. Review the settings, then "
"click Save & Continue."
msgstr[0] ""
"Zaimportowano profil; zostanie usunięty {count} pakiet. Sprawdź ustawienia i "
"kliknij Zapisz i kontynuuj."
msgstr[1] ""
"Zaimportowano profil; zostaną usunięte {count} pakiety. Sprawdź ustawienia i "
"kliknij Zapisz i kontynuuj."
msgstr[2] ""
"Zaimportowano profil; zostanie usuniętych {count} pakietów. Sprawdź "
"ustawienia i kliknij Zapisz i kontynuuj."

#: done_gui.py:82
msgid "Build complete"
msgstr "Kompilacja zakończona"

#: done_gui.py:98
msgid "Open output folder"
msgstr "Otwórz folder wyjściowy"

#: done_gui.py:100
msgid "Test in VirtualBox"
msgstr "Testuj w VirtualBox"

#: done_gui.py:102
msgid "Install VirtualBox"
msgstr "Zainstaluj VirtualBox"

#: done_gui.py:104
msgid "Test in QEMU"
msgstr "Testuj w QEMU"

#: done_gui.py:106
msgid "Install QEMU"
msgstr "Zainstaluj QEMU"

#: done_gui.py:108
msgid "Burn to USB"
msgstr "Zapisz na USB"

#: done_gui.py:110
msgid "Install USB writer"
msgstr "Zainstaluj narzędzie do zapisu USB"

#: done_gui.py:112
msgid "Open build log"
msgstr "Otwórz dziennik kompilacji"

#: done_gui.py:114
msgid "Save build profile…"
msgstr "Zapisz profil kompilacji…"

#: done_gui.py:116
msgid "Build again"
msgstr "Kompiluj ponownie"

#: done_gui.py:131
msgid ""
"Note: the test VM only boots the ISO once to check the installer; it cannot "
"reboot into an installed system. Test a real install on hardware."
msgstr ""
"Uwaga: testowa maszyna wirtualna uruchamia ISO tylko raz, aby sprawdzić "
"instalator; nie można jej ponownie uruchomić do zainstalowanego systemu. "
"Przetestuj prawdziwą instalację na sprzęcie."

#: done_gui.py:141
msgid "Output folder not found yet."
msgstr "Folder wyjściowy nie jest jeszcze dostępny."

#: done_gui.py:146
#, python-brace-format
msgid "No ISO found in {path}"
msgstr "Nie znaleziono ISO w {path}"

#: done_gui.py:193
msgid "VirtualBox (VBoxManage) not installed."
msgstr "VirtualBox (VBoxManage) nie jest zainstalowany."

#: done_gui.py:196
msgid "Creating a VirtualBox VM (UEFI + 50 GB disk) and booting the ISO…"
msgstr ""
"Tworzenie maszyny wirtualnej VirtualBox (UEFI + dysk 50 GB) i uruchamianie "
"ISO…"

#: done_gui.py:223
msgid "VirtualBox VM started."
msgstr "Uruchomiono maszynę wirtualną VirtualBox."

#: done_gui.py:224
#, python-brace-format
msgid "VirtualBox launch failed (exit {code})."
msgstr "Nie udało się uruchomić VirtualBox (kod wyjścia {code})."

#: done_gui.py:228
msgid "Installing VirtualBox + host DKMS + kernel headers (password required)…"
msgstr ""
"Instalowanie VirtualBox + DKMS hosta + nagłówków kernela (wymagane hasło)…"

#: done_gui.py:236
msgid ""
"VirtualBox installed. Reboot now (a log-out is not enough) to load the host "
"kernel modules and join the vboxusers group. Also enable virtualization in "
"your motherboard / BIOS-UEFI settings (Intel VT-x or AMD-V / SVM); "
"VirtualBox cannot run virtual machines without it."
msgstr ""
"VirtualBox jest zainstalowany. Uruchom komputer ponownie, aby załadować "
"moduły kernela i dołączyć do grupy vboxusers (wylogowanie nie wystarczy). "
"Włącz również wirtualizację w ustawieniach płyty głównej lub BIOS/UEFI "
"(Intel VT-x albo AMD-V / SVM); bez niej VirtualBox nie uruchomi maszyn "
"wirtualnych."

#: done_gui.py:244
#, python-brace-format
msgid "VirtualBox install failed (exit {code})."
msgstr "Nie udało się zainstalować VirtualBox (kod wyjścia {code})."

#: done_gui.py:255
msgid "OVMF not found (install edk2-ovmf); booting BIOS instead of UEFI."
msgstr ""
"Nie znaleziono OVMF (zainstaluj edk2-ovmf); uruchamianie z BIOS-em zamiast "
"UEFI."

#: done_gui.py:268
msgid "qemu-img not found; the installer will have no disk to install on."
msgstr ""
"Nie znaleziono qemu-img; instalator nie będzie miał dysku, na którym można "
"go zainstalować."

#: done_gui.py:275
msgid "Creating a fresh 50 GB virtual disk for the installer…"
msgstr "Tworzenie nowego wirtualnego dysku 50 GB dla instalatora…"

#: done_gui.py:279
#, python-brace-format
msgid "Failed to create disk: {error}"
msgstr "Nie można utworzyć dysku: {error}"

#: done_gui.py:285
msgid "Installing qemu-desktop (you will be asked for your password)…"
msgstr "Instalowanie qemu-desktop (pojawi się prośba o hasło)…"

#: done_gui.py:293
msgid "QEMU installed; you can now test in a VM."
msgstr "QEMU jest zainstalowany; możesz teraz testować w maszynie wirtualnej."

#: done_gui.py:298
#, python-brace-format
msgid "QEMU install failed (exit {code})."
msgstr "Nie udało się zainstalować QEMU (kod wyjścia {code})."

#: done_gui.py:310
msgid "Installing mintstick (you will be asked for your password)…"
msgstr "Instalowanie mintstick (pojawi się prośba o hasło)…"

#: done_gui.py:318
msgid "USB writer installed; you can now burn to USB."
msgstr ""
"Narzędzie do zapisu USB jest zainstalowane; możesz teraz zapisywać na USB."

#: done_gui.py:323
#, python-brace-format
msgid "USB writer install failed (exit {code})."
msgstr ""
"Nie udało się zainstalować narzędzia do zapisu USB (kod wyjścia {code})."

#: done_gui.py:331
msgid "Save build profile"
msgstr "Zapisz profil kompilacji"

#: done_gui.py:348
#, python-brace-format
msgid "Saved build profile ({count} package removed) → {path}"
msgid_plural "Saved build profile ({count} packages removed) → {path}"
msgstr[0] "Zapisano profil (usunięto {count} pakiet) → {path}"
msgstr[1] "Zapisano profil (usunięto {count} pakiety) → {path}"
msgstr[2] "Zapisano profil (usunięto {count} pakietów) → {path}"

#: extras_gui.py:35
msgid "Add apps"
msgstr "Dodaj aplikacje"

#: extras_gui.py:36
msgid "These apps are NOT on the standard Kiro; tick the ones you want added."
msgstr ""
"Tych aplikacji NIE MA w standardowym Kiro; zaznacz te, które chcesz dodać."

#: extras_gui.py:37
msgid ""
"Nothing is ticked by default. Tick none and your ISO stays the standard Kiro."
msgstr ""
"Domyślnie nic nie jest zaznaczone. Jeśli niczego nie zaznaczysz, ISO "
"pozostanie standardowym Kiro."

#: extras_gui.py:40
#, python-brace-format
msgid "{edition} extras"
msgstr "Dodatki dla {edition}"

#: extras_gui.py:41
#, python-brace-format
msgid ""
"Optional {edition} apps, added only to this {edition} build; tick what you "
"want."
msgstr ""
"Opcjonalne aplikacje {edition}, dodawane tylko do tej kompilacji {edition}; "
"zaznacz wybrane."

#: extras_gui.py:43
msgid "Nothing is ticked by default."
msgstr "Domyślnie nic nie jest zaznaczone."

#: extras_gui.py:44
msgid "Consider these a work in progress."
msgstr "Pamiętaj, że te aplikacje są wciąż w fazie rozwoju."

#: extras_gui.py:56
msgid "Search apps…"
msgstr "Szukaj aplikacji…"

#: extras_gui.py:58 packages_gui.py:73
msgid "Select all"
msgstr "Zaznacz wszystko"

#: extras_gui.py:60 packages_gui.py:75
msgid "Deselect all"
msgstr "Odznacz wszystko"

#: extras_gui.py:77
msgid "Save app list…"
msgstr "Zapisz listę aplikacji…"

#: extras_gui.py:79
msgid "Import app list…"
msgstr "Importuj listę aplikacji…"

#: extras_gui.py:122 packages_gui.py:125
msgid "packages.x86_64 not found; fix the clone on the Pre-flight screen."
msgstr ""
"Nie znaleziono packages.x86_64; napraw to na ekranie kontroli wstępnej."

#: extras_gui.py:136
msgid "No extra apps are offered yet."
msgstr "Obecnie nie ma dodatkowych aplikacji."

#: extras_gui.py:226
#, python-brace-format
msgid "App that will be added: {added}/{total}"
msgid_plural "Apps that will be added: {added}/{total}"
msgstr[0] "Aplikacja do dodania: {added}/{total}"
msgstr[1] "Aplikacje do dodania: {added}/{total}"
msgstr[2] "Aplikacji do dodania: {added}/{total}"

#: extras_gui.py:249
msgid "Save app list"
msgstr "Zapisz listę aplikacji"

#: extras_gui.py:263
#, python-brace-format
msgid "Saved app list ({count} app added) → {path}"
msgid_plural "Saved app list ({count} apps added) → {path}"
msgstr[0] "Zapisano listę aplikacji (dodano {count} aplikację) → {path}"
msgstr[1] "Zapisano listę aplikacji (dodano {count} aplikacje) → {path}"
msgstr[2] "Zapisano listę aplikacji (dodano {count} aplikacji) → {path}"

#: extras_gui.py:269
msgid "Import app list"
msgstr "Importuj listę aplikacji"

#: extras_gui.py:282
#, python-brace-format
